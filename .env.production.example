# =============================================================================
# AI Operations Agent Platform - deployed environment template
#
#   cp .env.production.example .env.production
#   # fill in every REPLACE_ME below, then:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# `.env.production` is git-ignored. This template is not, which is why it
# contains no value that would work anywhere: every secret below is the literal
# string REPLACE_ME, and the command that generates a real one is above it.
#
# Nothing here is read by the application directly. Compose reads this file and
# passes the values into the containers as environment variables, so no file of
# secrets is ever copied into an image.
#
# -- HOW THE APPLICATION BEHAVES IF YOU GET THIS WRONG -------------------------
#
# It refuses to start, and says which variable. A deployed environment will not
# come up on the development JWT secret, on the development database password,
# with DEBUG on, with a wildcard CORS origin, without the selected model
# provider's key, or with metrics enabled and no metrics token. That is
# deliberate: a deployment that starts with a published default in place is one
# where nothing appears to be wrong.
# =============================================================================

# -- Identity ------------------------------------------------------------------
APP_NAME=AI Operations Agent Platform
APP_ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# The interactive API documentation and the OpenAPI schema. Off by default: the
# schema is a complete map of every route, field and error code.
DOCS_ENABLED=false

# -- Who may call this API from a browser --------------------------------------
# Exact origins, comma-separated. `*` is refused in a deployed environment: the
# API sends credentials, and a wildcard with credentials means any site may call
# it as whoever is signed in. An empty value means no browser origin is trusted.
CORS_ORIGINS=https://console.example.com

# -- PostgreSQL ----------------------------------------------------------------
#   Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=aiops
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=aiops

# Must agree with the three values above when using the bundled database.
# Point it at a managed instance instead and the postgres service can be
# removed from docker-compose.prod.yml entirely.
#
# Percent-encode any character in the password that is special in a URL
# (@ : / ? # [ ] are the ones that bite).
DATABASE_URL=postgresql+asyncpg://aiops:REPLACE_ME@postgres:5432/aiops

# Connections per worker process, not per deployment. pool_size + max_overflow
# multiplied by the number of containers must stay under the server's
# max_connections.
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# Two bounds the pool does not provide. DATABASE_POOL_TIMEOUT limits how long a
# caller waits for an *existing* connection to come free, which does nothing at
# all when the server is unreachable; these limit reaching it and running one
# statement on it. Without them the limit is the operating system's, which on a
# network path that drops packets rather than refusing them is minutes.
#
# Raise the command timeout if a usage report over a large dataset is being cut
# off. Migrations are unaffected - Alembic builds its own engine, so a long
# schema change cannot be interrupted by this.
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_COMMAND_TIMEOUT_SECONDS=30

# -- Redis ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Redis is part of this stack, so an unreachable one makes the service unready.
REDIS_REQUIRED=true
REDIS_MAXMEMORY=256mb

# Ceiling on connecting to Redis and on one command. Short on purpose: the only
# caller today is the readiness probe, and a probe that hangs is worse than one
# that fails - an instance whose readiness never answers is never taken out of
# rotation, so traffic keeps arriving at something that cannot serve it. The
# client library defaults both of these to no timeout at all.
REDIS_TIMEOUT_SECONDS=2

# -- Authentication ------------------------------------------------------------
# Signs every access token. Anyone who has it can mint a token for any user in
# any organization, so it is the single most important value in this file.
#
#   Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Rotating it signs everybody out, which is the intended effect.
JWT_SECRET_KEY=REPLACE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# -- Model provider ------------------------------------------------------------
# Only the selected provider's key is required, and the application refuses to
# start in a deployed environment without it.
LLM_PROVIDER=anthropic
# Bounded above as well as below (300s ceiling): a deployment may be stricter
# than the ceiling, never more permissive, so a mistyped value cannot hold a
# worker and its database connection for an hour.
LLM_TIMEOUT_SECONDS=60

ANTHROPIC_API_KEY=REPLACE_ME
ANTHROPIC_MODEL=claude-opus-5

# OPENAI_API_KEY=REPLACE_ME
OPENAI_MODEL=gpt-5.5

LLM_MAX_RETRIES=2
LLM_RETRY_MAX_DELAY_SECONDS=8
# Models a caller may name, comma-separated. Empty means only the configured
# one, which is the safe default - otherwise a client can name an expensive
# model and bill this deployment for it.
LLM_ALLOWED_MODELS=

# -- Observability -------------------------------------------------------------
# GET /metrics is not served unless this is true, and there is no
# unauthenticated mode: enabling it without a token refuses to start.
#
#   Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
METRICS_ENABLED=false
METRICS_TOKEN=

# What tokens cost, as JSON, prices quoted as strings because a JSON number is
# a float by the time Python has read it. Leave empty and usage is reported in
# full with cost reported as unknown, which is the honest state for a
# deployment nobody has priced.
#
# LLM_PRICING={"version":"2026-01","models":{"claude-opus-5":{"input":"5.00","output":"25.00"}}}
LLM_PRICING=

# Spans for one request, recorded to the log. What a span may carry is an
# allow-list in the application; see docs/deployment.md.
TRACING_ENABLED=false
TRACING_SAMPLE_RATIO=1.0

# -- Process model -------------------------------------------------------------
# One uvicorn worker per container. The metrics registry lives in the process,
# so a multi-worker container reports whichever worker answered the scrape.
# Scale with more containers - docs/deployment.md, "Workers and metrics".
WEB_CONCURRENCY=1

# Which upstreams may set X-Forwarded-*. The default is the Docker bridge
# range, so the reverse proxy in front is trusted and a request that arrived
# some other way is not. Never `*` on a host where anything else can reach the
# container: X-Forwarded-For is what the application believes about the client.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# -- Where the containers listen -----------------------------------------------
# Loopback. A reverse proxy on this host terminates TLS and forwards to them.
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

BACKEND_MEMORY_LIMIT=1g
FRONTEND_MEMORY_LIMIT=512m

# -- Frontend build ------------------------------------------------------------
# Compiled into the browser bundle at BUILD time, so this is the address the
# BROWSER uses - a public URL, not an internal service name - and changing it
# means rebuilding the frontend image. Never put a secret under NEXT_PUBLIC_:
# it becomes a string literal in JavaScript that every visitor downloads.
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_APP_NAME=AI Operations Agent Platform

# -- Image tags ----------------------------------------------------------------
# Pin these to something that identifies the build - a version or a commit -
# once images are published to a registry rather than built on the host.
BACKEND_IMAGE=aiops-backend:prod
FRONTEND_IMAGE=aiops-frontend:prod
