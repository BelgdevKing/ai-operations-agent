# =============================================================================
# Backend - native development environment
#
#   copy .env.example .env
#
# Read by pydantic-settings when uvicorn is started from this directory. Every
# value here is already the built-in default, so the backend runs without this
# file; copy it when you need to change something.
#
# For the Docker stack use the .env.example in the repository root instead -
# there the hosts are Compose service names, not localhost.
#
# NEVER commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="AI Operations Agent Platform"
# development | staging | production | test
APP_ENV=development
DEBUG=true

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# console = readable lines while developing; json = one object per line
LOG_FORMAT=console

# Mount point for the versioned API. /health stays outside it.
API_V1_PREFIX=/api/v1

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL - must be running natively on localhost
#
# Create the role and database once:
#   psql -U postgres -c "CREATE ROLE aiops WITH LOGIN PASSWORD 'aiops_dev_password';"
#   psql -U postgres -c "CREATE DATABASE aiops OWNER aiops;"
#
# Then create the schema:
#   alembic upgrade head
#
# See docs/development-windows.md for the full walkthrough.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://aiops:aiops_dev_password@localhost:5432/aiops

# Log every SQL statement. Noisy; useful when debugging a query.
DATABASE_ECHO=false

# Connection pool
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Authentication
#
# JWT_SECRET_KEY signs access tokens. The built-in default is in the source
# repository, so anyone can forge a token with it - it is for local
# development only. Staging and production REFUSE TO START unless this is set
# to something else of at least 32 characters:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it invalidates every token already issued, which is also how you
# revoke them all at once.
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=dev-only-insecure-jwt-secret-change-me

# HS256, HS384 or HS512. Only HMAC algorithms are accepted, which is what
# prevents an algorithm-confusion attack.
JWT_ALGORITHM=HS256

# Lifetime of an access token. Short by design: there is no revocation list
# yet, so expiry is the only way a token stops working.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Minimum password length. Length is the only rule - composition requirements
# encourage predictable substitutions without adding entropy (NIST SP 800-63B).
PASSWORD_MIN_LENGTH=12

# Argon2id cost. Defaults exceed the OWASP minimum of 19 MiB / 2 iterations.
# Raise memory first: it is what makes GPU cracking expensive. Raising these
# is safe - existing hashes keep working and are upgraded on next login.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# -----------------------------------------------------------------------------
# Language model provider
#
# Only the SELECTED provider needs a key. A deployment using Anthropic does not
# need an OpenAI account, and vice versa - staging and production refuse to
# start without the selected one, while development starts regardless and fails
# at call time instead.
#
# Keys are held as secrets: they are masked in logs, reprs, tracebacks and
# serialised configuration. Never commit a real key.
# -----------------------------------------------------------------------------
LLM_PROVIDER=anthropic

# Ceiling on a single model call, so a request can never hang indefinitely.
LLM_TIMEOUT_SECONDS=60

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Gateway retry policy. The gateway is the only retry layer - the provider
# SDKs run with their own retries disabled - so at most LLM_MAX_RETRIES + 1
# calls ever reach a provider.
LLM_MAX_RETRIES=2

# Caps any single backoff wait, and the longest retry-after hint worth
# honouring; beyond it the gateway gives up rather than hold the caller.
LLM_RETRY_MAX_DELAY_SECONDS=8

# Models an API caller may name, comma-separated. Empty means only the
# configured model above - the safe default, since otherwise a client could
# name an expensive model and bill this deployment for it.
LLM_ALLOWED_MODELS=

# -----------------------------------------------------------------------------
# Redis - OPTIONAL
#
# No implemented feature uses Redis yet, so it does not need to be installed.
# With REDIS_REQUIRED=false the backend starts normally, /health/ready stays
# 200, and Redis is simply reported as unavailable.
#
# Set to true once a feature genuinely depends on it (caching, rate limiting,
# the background job queue). The Docker stack already sets it to true.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
