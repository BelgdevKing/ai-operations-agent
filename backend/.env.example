# =============================================================================
# Backend - native development environment
#
#   copy .env.example .env
#
# Read by pydantic-settings when uvicorn is started from this directory. Every
# value here is already the built-in default, so the backend runs without this
# file; copy it when you need to change something.
#
# For the Docker stack use the .env.example in the repository root instead -
# there the hosts are Compose service names, not localhost.
#
# NEVER commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="AI Operations Agent Platform"
# development | staging | production | test
APP_ENV=development
DEBUG=true

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# console = readable lines while developing; json = one object per line
LOG_FORMAT=console

# Mount point for the versioned API. /health stays outside it.
API_V1_PREFIX=/api/v1

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL - must be running natively on localhost
#
# Create the role and database once:
#   psql -U postgres -c "CREATE ROLE aiops WITH LOGIN PASSWORD 'aiops_dev_password';"
#   psql -U postgres -c "CREATE DATABASE aiops OWNER aiops;"
#
# Then create the schema:
#   alembic upgrade head
#
# See docs/development-windows.md for the full walkthrough.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://aiops:aiops_dev_password@localhost:5432/aiops

# Log every SQL statement. Noisy; useful when debugging a query.
DATABASE_ECHO=false

# Connection pool
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Redis - OPTIONAL
#
# No implemented feature uses Redis yet, so it does not need to be installed.
# With REDIS_REQUIRED=false the backend starts normally, /health/ready stays
# 200, and Redis is simply reported as unavailable.
#
# Set to true once a feature genuinely depends on it (caching, rate limiting,
# the background job queue). The Docker stack already sets it to true.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
