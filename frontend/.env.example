# =============================================================================
# Frontend - native development environment
#
#   copy .env.example .env.local
#
# Next.js reads .env.local automatically and it is git-ignored, which is why it
# is the right target for local overrides.
#
# Only NEXT_PUBLIC_* values are inlined into the browser bundle. Never put a
# secret in this file - anything here is public.
# =============================================================================

# Address of the backend API as seen by the BROWSER, so it is localhost even
# when the backend runs in a container.
NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_APP_NAME="AI Operations Agent Platform"
