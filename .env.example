# =============================================================================
# AI Operations Agent Platform - example environment file for the DOCKER stack
#
# Hosts here are Compose service names (postgres, redis), so this file suits
# `docker compose up` only. For native development use backend/.env.example and
# frontend/.env.example, which target localhost.
#
# Every value here is already the default baked into docker-compose.yml, so the
# stack runs without a .env file. Copy this file to .env only to override
# something. NEVER commit .env.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="AI Operations Agent Platform"
APP_ENV=development                 # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console                  # console | json
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Authentication
#
# JWT_SECRET_KEY signs access tokens. The default below is the one shipped in
# the repository - anyone can forge a token with it. Staging and production
# refuse to start unless it is replaced with at least 32 characters:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=dev-only-insecure-jwt-secret-change-me

# HS256, HS384 or HS512 only.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

PASSWORD_MIN_LENGTH=12

# Argon2id cost; above the OWASP minimum of 19 MiB / 2 iterations.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=4

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=aiops
POSTGRES_PASSWORD=aiops_dev_password
POSTGRES_DB=aiops
POSTGRES_HOST=postgres              # "localhost" when running the API outside Docker
POSTGRES_PORT=5432

# Full SQLAlchemy URL (async driver). Built from the values above.
DATABASE_URL=postgresql+asyncpg://aiops:aiops_dev_password@postgres:5432/aiops

# Alembic uses DATABASE_URL above - there is no separate sync URL to keep in step.
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Redis (cache, rate limiting, background job queue)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Redis is part of the Compose stack, so an unreachable Redis is a real fault
# here and /health/ready reports 503. Native development sets this to false.
REDIS_REQUIRED=true

# -----------------------------------------------------------------------------
# Anthropic / Claude  (NOT used yet - reserved for the AI phase)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# RAG / embeddings  (NOT used yet - reserved for the RAG phase)
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=voyage
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3
EMBEDDING_DIMENSIONS=1024
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=8

# -----------------------------------------------------------------------------
# Multi-tenancy
#
# The organization a request acts on comes from the caller's verified
# membership. Callers belonging to more than one organization choose between
# them with the X-Organization-ID header, which is always checked against
# their memberships - it grants nothing on its own. There is nothing to
# configure here.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Agent execution limits  (reserved for the agent phase)
# -----------------------------------------------------------------------------
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120
AGENT_REQUIRE_APPROVAL_FOR_WRITES=true

# -----------------------------------------------------------------------------
# File storage (documents awaiting ingestion)
# -----------------------------------------------------------------------------
STORAGE_BACKEND=local               # local | s3
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_SIZE_MB=25

# -----------------------------------------------------------------------------
# Frontend (Next.js) - only NEXT_PUBLIC_* values reach the browser
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="AI Operations Agent Platform"
